    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "chrome",
            "runtimeExecutable": "/usr/bin/brave-browser",
            "port": 9222,
            "request": "launch",
            "name": "BrowserSync Brave",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/src",
            "preLaunchTask": "lanzarBrowserSync",
            "postDebugTask": "matarBrowserSync"
        },
        {
            "type": "chrome",
            "runtimeExecutable": "/usr/bin/brave-browser",
            "port": 9222,
            "request": "launch",
            "name": "BrowserSync Debug",
            "url": "http://localhost:3000/test/index.html",
            "webRoot": "${workspaceFolder}/",
            "preLaunchTask": "debugBrowserSync",
            "postDebugTask": "matarBrowserSync"
        }
    ]
}