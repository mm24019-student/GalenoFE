{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lanzarBrowserSync",
      "command": "browser-sync start --server src --files \"src/**/*\" --no-open",
      "type": "shell",
      "presentation": { "reveal": "silent" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "browsersync",
        "pattern": { "regexp": "^__nunca__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving files from",
          "endsPattern": "Watching files"
        }
      }
    },
    {
      "label": "debugBrowserSync",
      "command": "browser-sync start --server ./ --files \"src/**/*\" \"test/**/*\" --no-open",
      "type": "shell",
      "presentation": { "reveal": "silent" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "browsersync",
        "pattern": { "regexp": "^__nunca__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving files from",
          "endsPattern": "Watching files"
        }
      }
    },
    {
      "label": "matarBrowserSync",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}